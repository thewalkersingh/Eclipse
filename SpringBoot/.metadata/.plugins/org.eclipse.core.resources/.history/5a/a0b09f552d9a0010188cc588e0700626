package com.thewa.medsyncservice.repository;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import com.thewa.medsyncservice.entity.Hospital;

public interface HospitalRepository extends JpaRepository<Hospital, Long> {
   Page<Hospital> findByLocationContainingIgnoreCase(String location, Pageable pageable);
   
   Page<Hospital> findByNameContainingIgnoreCase(String name, Pageable pageable);
}