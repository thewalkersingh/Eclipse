package org.horizon.threads.foodDeliveryAppOptimized;
import java.util.ArrayList;
import java.util.List;
import java.util.Random;

public class FoodDeliverySystemOptimized {
   public static void main(String[] args) {
	long startTime = System.currentTimeMillis();
	
	List<OrderOptimized> kitchenOrdersOptimized = new ArrayList<>();
	List<OrderOptimized> deliveryOrdersOptimized = new ArrayList<>();
	
	KitchenOptimized kitchenOptimized = new KitchenOptimized(kitchenOrdersOptimized);
	DriverOptimized driverOptimized = new DriverOptimized(deliveryOrdersOptimized);
	
	kitchenOptimized.start();
	driverOptimized.start();
	
	Random random = new Random();
	String[] footItems = { "Pizza", "Burger", "Sushi", "Pasta", "Salad", "Rolls" };
	
	for (int i = 1; i <= 10; i++) {
	   OrderOptimized orderOptimized = new OrderOptimized(i, footItems[random.nextInt(footItems.length)]);
	   
	   synchronized (kitchenOrdersOptimized) {
		kitchenOrdersOptimized.add(orderOptimized);
		kitchenOrdersOptimized.notify();
	   }
	   
	   System.out.println("----------------------------------------------");
	   System.out.println("New Order Placed: " + orderOptimized);
	   synchronized (deliveryOrdersOptimized) {
		deliveryOrdersOptimized.add(orderOptimized);
		deliveryOrdersOptimized.notify();
	   }
	   
	   try {
		Thread.sleep(2000);
	   } catch (InterruptedException e) {
		System.err.println(e);
	   }
	}
	long endTime = System.currentTimeMillis();
	long timeTaken = endTime - startTime;
	System.out.println("Total time taken: " + timeTaken);
   }
}
