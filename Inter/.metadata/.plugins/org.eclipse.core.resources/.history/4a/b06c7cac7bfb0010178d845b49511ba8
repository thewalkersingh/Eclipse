package hashmap;
import java.util.ArrayList;
import java.util.List;

public class HashMap<K, V> {
   int size;
   int bucketSize;
   List<MapNode<K, V>> bucket;
   
   public HashMap() {
      bucketSize = 5;
      bucket = new ArrayList<>(bucketSize);
      for (int i = 0; i < bucketSize; i++) {
	 bucket.add(null);
      }
   }
   
   public HashMap(int bucketSize) {
      bucket = new ArrayList<>(bucketSize);
   }
   
   public V get(K key) {
      int i = getBucketIndex(key);
      MapNode<K, V> head = bucket.get(i);
      while (head != null) {
	 if (head.key == key)
	    return head.value;
	 head = head.next;
      }
      return null;
   }
   
   private int getBucketIndex(K key) {
      int bucketKey = key.hashCode();
      return bucketKey % bucketSize;
   }
   
   public void put(K key, V value) {
      int i = getBucketIndex(key);
      MapNode<K, V> head = bucket.get(i);
      while (head != null) {
	 if (head.key.equals(key)) {
	    head.value = value;
	    return;
	 }
	 head = head.next;
      }
      head = bucket.get(i);
      MapNode<K, V> element = new MapNode<>(key, value);
      element.next = head;
      bucket.set(i, element);
      size++;
      if (loadFactor() > 0.7)
	 rehash();
   }
   
   private double loadFactor() {
      return (1.0 * size) / bucketSize;
   }
   
   private void rehash() {
      System.out.println("Rehashing: bucketArray " + bucketSize + " size " + size);
      List<MapNode<K, V>> temp = bucket;
      bucket = new ArrayList<>(2 * bucketSize);
      size = 0;
      for (int i = 0; i < temp.size(); i++) {
	 MapNode<K, V> head = temp.get(i);
	 while (head != null) {
	    K key = head.key;
	    V value = head.value;
	    put(key, value);
	    head = head.next;
	    size++;
	 }
      }
   }
   
   public int size() {
      return size;
   }
   
   public boolean isEmpty() {
      return bucket.isEmpty();
   }
}
