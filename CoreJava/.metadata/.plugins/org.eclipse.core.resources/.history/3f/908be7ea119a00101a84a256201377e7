public class ReverseTheArrayList {
   public static void main(String[] args) {
//      int[] ele = { 10, 4, 5, 2, 3, 6, 1, 3, 6 };
      ArrayList<Integer> arr = new ArrayList<>();
      arr.add(1);
      arr.add(2);
      arr.add(3);
      arr.add(4);
      arr.add(5);
      arr.add(6);
      // arr.add(10);
      // arr.add(9);
      // arr.add(8);
      // arr.add(7);
      // arr.add(6);
      System.out.println(reverseArray(arr, 3));
   }

   public static ArrayList<Integer> reverseArray(ArrayList<Integer> arr, int m) {
      // Write your code here.
      // System.out.println(arr.get(5));
      int i = m + 1;
      int j = arr.size() - 1;
      int leftElement;
      int rightElement;
      while (i <= j) {
	 leftElement = arr.get(i);
	 rightElement = arr.get(j);
	 arr.set(j, leftElement);
	 arr.set(i, rightElement);
	 i++;
	 j--;
      }
      return arr;
   }
}