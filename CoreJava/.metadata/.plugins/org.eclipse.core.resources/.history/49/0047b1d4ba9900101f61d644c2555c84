package arrayList;
import java.util.ArrayList;
import java.util.Collections;
import java.util.TreeMap;

public class FindKMaximumElements {
   public static void main(String[] args) {
      ArrayList<Integer> arr = new ArrayList<>();
      arr.add(4);
      arr.add(2);
      arr.add(4);
      arr.add(2);
      arr.add(1);
      System.out.println(firstKMax(arr, 5, 2));
   }

   public static ArrayList<Integer> firstKMax(ArrayList<Integer> arr, int n, int k) {
      TreeMap<Integer, ArrayList<Integer>> indexes = new TreeMap<>();
      for (int i = 0; i < arr.size(); i++) {
	 int element = arr.get(i);
	 if (!indexes.containsKey(element)) {
	    ArrayList<Integer> current = new ArrayList<>();
	    current.add(i);
	    indexes.put(element, current);
	 } else
	    indexes.get(element).add(i);
      }
      ArrayList<Integer> unique = new ArrayList<>();
      ArrayList<Integer> answer = new ArrayList<>();
      for (Integer key : indexes.keySet())
	 unique.add(key);
      int uniqueIndex = unique.size() - 1;
      while (k > 0) {
	 int element = unique.get(uniqueIndex);
	 for (int i = 0; i < indexes.get(element).size(); i++)
	    answer.add(indexes.get(element).get(i));
	 uniqueIndex--;
	 k--;
      }
      Collections.sort(answer);
      return answer;
   }
}