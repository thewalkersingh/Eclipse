package arrayList;
import java.util.ArrayList;
import java.util.Collections;

public class KthSmallestAndLargest {
   public static void main(String[] args) {
      ArrayList<Integer> arr = new ArrayList<>();
      arr.add(1);
      arr.add(2);
      arr.add(3);
      arr.add(12);
      arr.add(15);
      arr.add(16);
      arr.add(18);
      arr.add(51);
      arr.add(10);
      int k = 3;
      int n = 9;
      kthSmallLarge(arr, n, k);
      System.out.println(arr);
      System.out.println(kthSmallLarge(arr, n, k));
   }

   public static ArrayList<Integer> kthSmallLarge(ArrayList<Integer> arr, int n, int k) {
      int len = arr.size();
      Collections.sort(arr);
      ArrayList<Integer> ans = new ArrayList<>();
      ans.add(arr.get(k - 1));
      ans.add(arr.get(len - k));
      return ans;
   }
}
/*
 * You are given an array ‘Arr’ consisting of ‘N’ distinct integers and a
 * positive integer ‘K’. Find out Kth smallest and Kth largest element of the
 * array. It is guaranteed that K is not greater than the size of the array.
