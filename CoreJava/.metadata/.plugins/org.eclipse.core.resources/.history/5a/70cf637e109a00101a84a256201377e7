package linkedList;
// Definition for singly-linked list.

public class AddTwoNumbers {
   public static void main(String[] args) {
      List_Node l1 = new List_Node(2);
      l1.next = new List_Node(4);
      l1.next = new List_Node(3);
      while (l1.next != null)
	 System.out.print(l1.val);
   }
   
   public List_Node addTwoNumbers(List_Node l1, List_Node l2) {
      List_Node ans = new List_Node();
      while (l1.next != null)
	 ans.val = l1.val + l2.val;
      return ans;
   }
}
