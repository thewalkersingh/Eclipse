package linkedList;
public class Swap_List_Nodes_in_pairs {
   public static void main(String[] args) {
      List_Node A = new List_Node(1);
      A.next = new ListNode(2);
      A.next.next = new ListNode(3);
      A.next.next.next = new ListNode(4);
      List_Node ans = swapPairs(A);
      System.out.println(ans.toString());
   }
   
   public static ListNode swapPairs(List_Node A) {
      List_Node tempHead = A;
      List_Node head = A;
      while (tempHead != null) {
	 List_Node first = tempHead.next.next;
	 List_Node second = tempHead.next;
	 tempHead = tempHead.next.next;
	 first.next = second;
      }
      return head;
   }
}

class List_Node {
   public int val;
   public List_Node next;
   
   List_Node(int x) {
      val = x;
      next = null;
   }
}