package topAlgos;

public class NetworkConnectivityExample {
   public static void main(String[] args) {
      UnionFind uf = new UnionFind(5); // 5 computers
      
      // Establish connections (union operations)
      uf.union(0, 1); // Computer 0 is connected to Computer 1
      uf.union(1, 2); // Computer 1 is connected to Computer 2
      uf.union(3, 4); // Computer 3 is connected to Computer 4
      
      // Check if computers 0 and 2 are connected (true)
      System.out.println("Are computers 0 and 2 connected? " + uf.connected(0, 2));
      
      // Check if computers 0 and 3 are connected (false)
      System.out.println("Are computers 0 and 3 connected? " + uf.connected(0, 3));
   }
}
